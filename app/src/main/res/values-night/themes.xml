<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme - Holo inspired -->
    <style name="Base.Theme.MyApplication" parent="Theme.AppCompat.NoActionBar">
        <!-- Holo Blue colors -->
        <item name="colorPrimary">@color/holo_blue_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/holo_blue_light</item>

        <!-- Dark background colors -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>

        <!-- Text colors for dark mode -->
        <item name="android:textColorPrimary">@color/dark_primary_text</item>
        <item name="android:textColorSecondary">@color/dark_secondary_text</item>

        <!-- Button style -->
        <item name="buttonStyle">@style/HoloButton</item>
    </style>

    <!-- Classic Holo-style button -->
    <style name="HoloButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_holo_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>