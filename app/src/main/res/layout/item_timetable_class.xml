<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/class_card_bg"
    android:clipChildren="false">

    <!-- Time indicator line (positioned absolutely) -->
    <View
        android:id="@+id/timeIndicator"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFE53935"
        android:visibility="gone"
        android:elevation="1dp" />

    <!-- Time indicator circle on left edge -->
    <View
        android:id="@+id/timeIndicatorCircle"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/time_indicator_circle"
        android:visibility="gone"
        android:elevation="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="2dp">

        <!-- Attendance Status Indicator Bar -->
        <View
            android:id="@+id/attendanceIndicator"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#3a87ad" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Time Column with Holo style -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp"
                android:background="@drawable/time_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/startTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:15"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/holo_blue_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="to"
                    android:textSize="10sp"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/endTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:05"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

            </LinearLayout>

            <!-- Class Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Subject Name with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_class"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Subject" />

                    <TextView
                        android:id="@+id/courseCodeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Science..."
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary"
                        android:maxLines="2"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Course Code -->
                <TextView
                    android:id="@+id/subjectCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(DSC309)"
                    android:textSize="12sp"
                    android:textColor="@color/holo_blue_dark"
                    android:layout_marginStart="26dp"
                    android:layout_marginBottom="4dp" />

                <!-- Teacher and Location on same line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_teacher"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/teacherText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dr Debarpita Santra"
                        android:textSize="13sp"
                        android:textColor="?android:textColorSecondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/locationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="406B"
                        android:textSize="13sp"
                        android:textColor="?android:textColorSecondary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
