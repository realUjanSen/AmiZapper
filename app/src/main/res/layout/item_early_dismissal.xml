<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/early_dismissal_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <!-- Celebration Icon/Emoji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="32sp"
            android:layout_marginBottom="8dp" />

        <!-- Congratulations Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Congratulations!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="4dp" />

        <!-- Classes End Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your classes end early today at"
            android:textSize="14sp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="8dp" />

        <!-- End Time (Bold and Larger) -->
        <TextView
            android:id="@+id/dismissalTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:50"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="12dp" />

        <!-- Transportation Reminder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚌 Don't forget to check for bus and shuttle timings!"
            android:textSize="13sp"
            android:textColor="#388E3C"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
