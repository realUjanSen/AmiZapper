<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Holo inspired -->
    <style name="Base.Theme.MyApplication" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Holo Blue colors -->
        <item name="colorPrimary">@color/holo_blue_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/holo_blue_light</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>

        <!-- Button style - classic Android -->
        <item name="buttonStyle">@style/HoloButton</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <!-- Classic Holo-style button -->
    <style name="HoloButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_holo_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>