

$(document).ready(function () {

    Callcalendar('agendaDay');
    // startDate: '-15d',        autoclose: true,        //  endDate: '+0d'
    $('#MyCalender').datepicker({ format: 'dd/mm/yyyy', }).on('changeDate', function (e) {
        var formated = e.format(0, "mm/dd/yyyy");
        $('#calendar').fullCalendar('gotoDate', formated);
    });
});
function Callcalendar(view) {
    var date = new Date();
    var d = date.getDate();
    var m = date.getMonth()+1;
    var y = date.getFullYear();
    var obj;


    $('#calendar').fullCalendar({
        

        header: {
            left: 'prev,next, myCustomButton',
            center: 'title',
            right: '',
            // right: 'agendaDay,month,listDay',
        },
        customButtons: {
            myCustomButton: {
                text: 'calender',
                theme: false,
                icon: 'fa fa fa-calendar mycls',
                click: function () {
                    $('.mycls').datepicker({
                        format: 'dd/mm/yyyy',
                        //startDate: '-15d',
                        autoclose: true,
                        //  endDate: '+0d'
                    }).on('changeDate', function (e) {

                        var formated = e.format(0, "mm/dd/yyyy");
                        $('#calendar').fullCalendar('gotoDate', formated);
                    });

                    $('.mycls').datepicker('show');

                }

            }

        },
        timeFormat: 'HH:mm',
        height: 810,


        defaultView: 'listDay',
     //   navLinks: true, // can click day/week names to navigate views
  //      editable: false,
  //      eventLimit: true, // allow "more" link when too many events
      //  minTime: '08:15:00',
      //  maxTime: '21:10:00',
   //     slotEventOverlap: false,
   //     eventLimit: true,
 //       editable: false,
        events: '/Calendar/home/GetDiaryEvents',
        //eventContent: function (arg) {
        //    var html = arg.event.extendedProps.RoomNo;
        //    console.log(html);

        //    // Create a div with raw HTML content
        //    var customHtml = document.createElement('div');
        //    customHtml.innerHTML = html;

        //    // Add the raw HTML to the title
        //    return { html: customHtml.innerHTML };
        //},
        //eventClick: function (event) {
            
        //    if (event.url) {
        //        window.open(event.url, "_blank");
        //        return false;
        //    }
        //}

        eventRender: function (event, element, view) {
            // For month/agenda/grid views
            if (element.find('.fc-title').length > 0) {
                let faculty = event.FacultyName || "";
                let room = event.RoomNo || "";

                // Clear existing text and set raw HTML
                element.find('.fc-title').html(event.title + "<br/>" + faculty + "<br/>" + room);
            }

            // For list views
            if (element.find('.fc-list-item-title a').length > 0) {
                let faculty = event.FacultyName || "";
                let room = event.RoomNo || "";

                // Same here: inject HTML directly
                element.find('.fc-list-item-title a').html(event.title + "<br/>" + faculty + "<br/>" + room);
            }
        },
        eventClick: function (event) {
            if (event.url) {
                window.open(event.url, "_blank");
                return false;
            }
        }





    });

    $(".fc-month-button").text("");
    if ($("#calendar").width() > 502) {
        $(".fc-month-button").show();
        $(".fc-month-button").append('<i class="ace-icon fa fa-calendar"></i>');
    }
    else {
        $(".fc-month-button").hide();
    }
    $(".fc-agendaDay-button").text("");
    $(".fc-agendaDay-button").append('<i class="ace-icon fa fa-sun-o"></i>');
    $(".fc-listDay-button").text("");
    $(".fc-listDay-button").append('<i class="ace-icon fa fa-list"></i>');


}
function readyFn(id) {

    $.ajax({
        url: '/Calendar/home/ShowEvents',
        data: { "id": id },
        type: "POST", async: false, dataType: "html",
        success: function (data) {
            $("#NoticeBoard").html(data);
        }
    });
}