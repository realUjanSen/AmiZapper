# Auto detect text files and perform LF normalization
* text=auto

# Explicitly set line endings for specific file types
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.so binary
*.apk binary
*.aab binary
